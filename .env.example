PORT=3000
ALLOWED_ORIGIN=https://meet.dayanigroup.com

# Use your own TURN/STUN service in production. The Node service derives
# short-lived credentials from this coturn TURN-REST shared secret.
STUN_URL=stun:turn.dayanigroup.com:3478
TURN_URL=turn:turn.dayanigroup.com:3478?transport=udp,turn:turn.dayanigroup.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-a-long-random-secret
