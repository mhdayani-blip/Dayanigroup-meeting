# Generate a strong random value before production. This stays only on the
# server; the meeting server issues short-lived TURN REST credentials to calls.
TURN_SHARED_SECRET=replace-with-a-long-random-secret

# The VPS public IPv4 address, used by coturn for relay candidates.
PUBLIC_IP=203.0.113.10

# CPU works for initial testing. Use cuda only on a compatible NVIDIA GPU server.
MODEL_DEVICE=cpu
WHISPER_MODEL=base
TRANSLATION_MODEL=santhosh/madlad400-3b-ct2
TRANSLATION_CHUNK_SECONDS=3.0
